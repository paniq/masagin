// this is a lame way to deal with shader permutations, but there was the
// request that this should work with vs_1_0

asc
{
  cbuffer sMsgMaterialEnvPara : register(c0) : slot vs 0
  {
    row_major float4x4 mvp;
    float4x3 mv;
    
    float4 color;				// material color
    float4 grow;        // grow position and scale

    extern void Set()
    {
      sGetMatrix(mvp,sGM_MODELSCREEN); 
      sGetMatrix(mv,sGM_MODELVIEW); 
      color.Init(1,1,1,1);
      grow.Init(1.0,1.0,1.0,1.0);
    }

    extern void Set(sMaterialEnv &env)
    {
      sGetMatrix(mvp,sGM_MODELSCREEN);
      sGetMatrix(mv,sGM_MODELVIEW);
    }
  };
}

/****************************************************************************/

material sMsgMaterial
{
  header 
  {
    sInt VerbFlags;
  }

  vs
  {
    asc vs_2_0                 // hlsl code
    {
      use sMsgMaterialEnvPara;
      void main
      (
        in float4 in_pos : POSITION,
        in float4 in_col : COLOR0,
        out float4 out_pos : POSITION,
        out float4 out_col : COLOR0,
      )
      {
        out_col = color * in_col;
        out_pos = mul(in_pos,mvp);
      }
    }
  }

  ps
  {
    asc ps_2_0
    {
      sampler2D s0 : register(s0);

      void main
      (
        in float4 color : COLOR0,
        out float4 result : COLOR0
      )
      {
        result = color;
      }
    }
    
  }
};

material sMsgMaterialGrowable : sMsgMaterial
{
  vs
  {
    asc vs_2_0                 // hlsl code
    {
      use sMsgMaterialEnvPara;
      void main
      (
        in float4 in_pos : POSITION,
        in float4 in_col : COLOR0,
        in float2 in_uv0 : TEXCOORD0,
        out float4 out_pos : POSITION,
        out float4 out_col : COLOR0,
        out float2 out_uv0 : TEXCOORD0,
      )
      {
        float4 c = color;

        float gy = grow.y;
        float g = grow.x;//(1.26*gy + 1.0f * (1.0f - gy));
        out_uv0 = in_uv0;
        if (g <= 0.0)
          out_uv0.x += 0.6;
        else if (g >= 1.0)
          out_uv0.x -= 0.6;
        else
          out_uv0.x = (out_uv0.x - g)*grow.z*64 + 0.5f;
        
        float pos = clamp((g - in_uv0.x)*grow.w,-0.1,1.1);
        out_uv0.y = out_uv0.y - 0.5 + pos*gy + 1.0f*(1.0f - gy);

        c *= in_col;

        out_col = c;
        out_pos = mul(in_pos,mvp);
      }
    }
  }

  ps
  {
    asc ps_2_0
    {
      sampler2D s0 : register(s0);

      void main
      (
        in float2 uv0 : TEXCOORD0,
        in float4 color : COLOR0,
        out float4 result : COLOR0
      )
      {
        result = color * tex2D(s0,uv0);
      }
    }
    
  }
};

