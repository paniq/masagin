// this is a lame way to deal with shader permutations, but there was the
// request that this should work with vs_1_0

asc
{
  cbuffer sIppToolMaterialVSPara : register(c0) : slot vs 0
  {
    row_major float4x4 mvp;     // rotation for light vector (not really needed)
  };
  cbuffer sIppToolMaterialPSPara : register(c12) : slot vs 0
  {
    float4 ColorAdd;
    float4 Color0;
    float4 Color1;
    float4 ColorMul;
  };

  permute sIppToolMaterialPSPerm
  {
    T0;
    T1;
    T2;
    T3;
    Special {Normal,Spread8,Burnout,Gray,Dof,Spread8Far,Boost};
    assert(T1 implies T0);
    assert(T2 implies T1);
    assert(T3 implies T2);
    assert(Special==Spread8 implies (T0 && !T1));
    assert(Special==Spread8Far implies (T0 && T1));
    assert(Special==Burnout implies T0);
    assert(Special==Gray implies T0);
    assert(Special==Dof implies (T0&&T1));
    assert(Special==Boost implies (T0&&T1));
  };
}

/****************************************************************************/

material sIppToolMaterial
{
  header
  {
    sInt Specials;
  }
  new
  {
    Specials = 0;
  }
  prepare
  {
    sInt n;
    
    // pick vertex shader

    VertexShader = VS();

    // pick pixel shader (number of textures)

    n = 0;
    if(Texture[0])
      n |= sIppToolMaterialPSPermMask_T0;
    if(Texture[1])
      n |= sIppToolMaterialPSPermMask_T1;
    if(Texture[2])
      n |= sIppToolMaterialPSPermMask_T2;
    if(Texture[3])
      n |= sIppToolMaterialPSPermMask_T3;
    switch(Specials&15)
    {
      case 1:      n |= sIppToolMaterialPSPerm_Spread8;         break;
      case 2:      n |= sIppToolMaterialPSPerm_Burnout;         break;
      case 3:      n |= sIppToolMaterialPSPerm_Gray;            break;
      case 4:      n |= sIppToolMaterialPSPerm_Dof;             break;
      case 5:      n |= sIppToolMaterialPSPerm_Spread8Far;      break;
      case 6:      n |= sIppToolMaterialPSPerm_Boost;           break;
    }
    PixelShader = PS(n); 
  }
  
  vs
  {
    asc vs_2_0                 // hlsl code
    {
      use sIppToolMaterialVSPara;
      use sIppToolMaterialPSPara;
      void main
      (
        in float4 in_pos : POSITION,
        in float2 in_uv0 : TEXCOORD0,
        in float2 in_uv1 : TEXCOORD1,
        out float4 out_pos : POSITION,
        out float2 out_uv0 : TEXCOORD0,
        out float2 out_uv1 : TEXCOORD1,
        out float4 out_ColorAdd : TEXCOORD2,
        out float4 out_Color0 : TEXCOORD3,
        out float4 out_Color1 : TEXCOORD4,
        out float4 out_ColorMul : TEXCOORD5,
      )
      {
        out_uv0 = in_uv0;
        out_uv1 = in_uv1;
        out_pos = mul(in_pos,mvp);
        out_ColorAdd = ColorAdd;
        out_Color0 = Color0;
        out_Color1 = Color1;
        out_ColorMul = ColorMul;
      }
    }
  }

  ps
  {
    asc ps_2_0
    {
      use sIppToolMaterialPSPerm;

      sampler2D s0 : register(s0) : pif(T0);
      sampler2D s1 : register(s1) : pif(T1);
      sampler2D s2 : register(s2) : pif(T2);
      sampler2D s3 : register(s3) : pif(T3);

      void main
      (
        in float2 uv0 : TEXCOORD0 : pif(T0),
        in float2 uv1 : TEXCOORD1 : pif(T1 || Spread8 || Spread8Far),
        in float4 ColorAdd : TEXCOORD2,
        in float4 Color0 : TEXCOORD3,
        in float4 Color1 : TEXCOORD4,
        in float4 ColorMul : TEXCOORD5,
        out float4 result : COLOR0
      )
      {
        pif(Special==Normal || Special==Burnout || Special==Gray)
        {
          float4 t0,t1,t2,t3;
          pif(T0)
            t0 = tex2D(s0,uv0);
          pelse
            t0 = 0;
          pif(T1)
            t1 = tex2D(s1,uv1);
          pelse
            t1 = 0;
          pif(T2)
            t2 = tex2D(s2,uv0);
          pelse
            t2 = 0;
          pif(T3)
            t3 = tex2D(s3,uv1);
          pelse
            t3 = 0;
            
          pif(Special==Burnout)
          {
            if(t0.a>0)
            {
              float f = 1/t0.a;
              f = min(f,Color1.a);
              t0 *= f;
            }
          }

          result = ColorAdd + t0*Color0 + t1*Color1 + t2*Color0 + t3*Color1 + t0*t1*ColorMul;

          pif(Special==Gray)
          {
            result.xyz = dot(result.xyz,1/3.0f);
          }
        }
        pif(Special==Spread8)
        {
          result  = tex2D(s0,uv0+0*uv1)*Color0.x;
          result += tex2D(s0,uv0+1*uv1)*Color0.y;
          result += tex2D(s0,uv0+2*uv1)*Color0.z;
          result += tex2D(s0,uv0+3*uv1)*Color0.w;
          result += tex2D(s0,uv0+4*uv1)*Color1.x;
          result += tex2D(s0,uv0+5*uv1)*Color1.y;
          result += tex2D(s0,uv0+6*uv1)*Color1.z;
          result += tex2D(s0,uv0+7*uv1)*Color1.w;
        }
        pif(Special==Spread8Far)
        {
          float depth = tex2D(s1,uv0+3.5*uv1).w-ColorAdd.w;     // ColorAdd.w = how far things may be away
          float4 cmp0,cmp1;
          
          cmp0.x  = tex2D(s1,uv0+0*uv1).w;
          cmp0.y  = tex2D(s1,uv0+1*uv1).w;
          cmp0.z  = tex2D(s1,uv0+2*uv1).w;
          cmp0.w  = tex2D(s1,uv0+3*uv1).w;
          cmp1.x  = tex2D(s1,uv0+4*uv1).w;
          cmp1.y  = tex2D(s1,uv0+5*uv1).w;
          cmp1.z  = tex2D(s1,uv0+6*uv1).w;
          cmp1.w  = tex2D(s1,uv0+7*uv1).w;
          
          cmp0 = step(depth,cmp0)+0.001;                     // 0.001: kicks in when sum is zero 
          cmp1 = step(depth,cmp1)+0.001;
          cmp0 *= Color0;
          cmp1 *= Color1;

          float sum = 1/(dot(cmp0,1)+dot(cmp1,1));


          result  = tex2D(s0,uv0+0*uv1)*cmp0.x;
          result += tex2D(s0,uv0+1*uv1)*cmp0.y;
          result += tex2D(s0,uv0+2*uv1)*cmp0.z;
          result += tex2D(s0,uv0+3*uv1)*cmp0.w;
          result += tex2D(s0,uv0+4*uv1)*cmp1.x;
          result += tex2D(s0,uv0+5*uv1)*cmp1.y;
          result += tex2D(s0,uv0+6*uv1)*cmp1.z;
          result += tex2D(s0,uv0+7*uv1)*cmp1.w;
          
          result *= sum;
        }
        pif(Special==Dof)
        {
          float4 t0 = tex2D(s0,uv0);
          float4 t1 = tex2D(s1,uv1);
          
          float dist = abs(t0.w-Color1.w);
          
          result.xyz = t1.xyz;
          result.w = dist*Color1.z;
        }
        pif(Special==Boost)
        {
          float4 orig = tex2D(s0,uv0);
          float4 blurred = tex2D(s1,uv1);
          
          blurred.xyz = dot(blurred.xyz,1/6.0f)+blurred.xyz*0.5f;
          float3 factor = 1/(max(blurred.xyz,Color0.xyz))*Color1.xyz;          
          
          result.xyz = orig.xyz * factor;
          result.w = orig.w;
        }
      }
    }
  }
};

/****************************************************************************/
